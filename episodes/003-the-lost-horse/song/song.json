 "lines": [
  {
   "id": "L01",
   "t0": 0.3,
   "t1": 5.6,
   "text": "An old farmer's only horse ran away one day"
  },
  {
   "id": "L02",
   "t0": 5.68,
   "t1": 11.1,
   "text": "What bad luck, the neighbors said, but maybe, he would say"
  },
  {
   "id": "L03",
   "t0": 11.18,
   "t1": 16.01,
   "text": "Days later the horse came home and brought a wild stallion"
  },
  {
   "id": "L04",
   "t0": 16.09,
   "t1": 21.6,
   "text": "What good luck, the neighbors cried, and maybe, said the old man"
  },
  {
   "id": "L05",
   "t0": 21.61,
   "t1": 26.45,
   "text": "His son tried to ride the wild horse, he fell and broke his leg"
  },
  {
   "id": "L06",
   "t0": 26.53,
   "t1": 32.04,
   "text": "What bad luck, they said again, and maybe, he said"
  },
  {
   "id": "L07",
   "t0": 32.06,
   "t1": 37.21,
   "text": "Then soldiers came and took the young men off to war"
  },
  {
   "id": "L08",
   "t0": 37.29,
   "t1": 42.21,
   "text": "Every young man but the one with the broken leg"
  },
  {
   "id": "L09",
   "t0": 42.29,
   "t1": 47.64,
   "text": "Good luck or bad luck"
  },
  {
   "id": "L10",
   "t0": 47.66,
   "t1": 50.66,
   "text": "Who knows what today will turn into"
  }
 ]
}