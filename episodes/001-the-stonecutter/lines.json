[
 {"id":"L01","text":"There once was a stonecutter, who wished to be the mightiest thing in the world.","voice":"bm_george","speed":0.9},
 {"id":"L02","text":"One day, a rich lord passed by.","voice":"bm_george","speed":0.9},
 {"id":"L03","text":"\"If only I were him,\" he sighed.","voice":"bm_george","speed":0.88},
 {"id":"L04","text":"And so he was.","voice":"bm_george","speed":0.86},
 {"id":"L05","text":"But the sun beat down, even on lords.","voice":"bm_george","speed":0.9},
 {"id":"L06","text":"\"I want to be the sun!\"","voice":"bm_george","speed":0.92},
 {"id":"L07","text":"So he became the sun, and scorched the earth,","voice":"bm_george","speed":0.9},
 {"id":"L08","text":"until a cloud covered him.","voice":"bm_george","speed":0.88},
 {"id":"L09","text":"\"Then let me be the cloud!\"","voice":"bm_george","speed":0.92},
 {"id":"L10","text":"He rained, and rained, and flooded the land.","voice":"bm_george","speed":0.9},
 {"id":"L11","text":"But one thing did not move.","voice":"bm_george","speed":0.86},
 {"id":"L12","text":"\"Let me be the mountain.\"","voice":"bm_george","speed":0.86},
 {"id":"L13","text":"Now he was mighty. Unmoving.","voice":"bm_george","speed":0.84},
 {"id":"L14","text":"Until he felt something at his feet.","voice":"bm_george","speed":0.84},
 {"id":"L15","text":"A stonecutter.","voice":"bm_george","speed":0.8},
 {"id":"L16","text":"\"Let me be myself,\" he whispered.","voice":"bm_george","speed":0.8},
 {"id":"L17","text":"Whatever you become, something will seem greater.","voice":"bm_george","speed":0.84},
 {"id":"L18","text":"Peace begins with who you are.","voice":"bm_george","speed":0.8}
]
