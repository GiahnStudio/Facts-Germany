[
 {
  "t0": 0.9,
  "t1": 5.82,
  "text": "There once was a stonecutter, who wished to be the mightiest thing in the world."
 },
 {
  "t0": 5.9,
  "t1": 8.72,
  "text": "One day, a rich lord passed by."
 },
 {
  "t0": 8.8,
  "t1": 12.1,
  "text": "\"If only I were him,\" he sighed."
 },
 {
  "t0": 12.9,
  "t1": 14.92,
  "text": "And so he was."
 },
 {
  "t0": 15.0,
  "t1": 18.22,
  "text": "But the sun beat down, even on lords."
 },
 {
  "t0": 18.3,
  "t1": 20.77,
  "text": "\"I want to be the sun!\""
 },
 {
  "t0": 21.4,
  "t1": 24.62,
  "text": "So he became the sun, and scorched the earth,"
 },
 {
  "t0": 24.7,
  "t1": 26.92,
  "text": "until a cloud covered him."
 },
 {
  "t0": 27.0,
  "t1": 29.32,
  "text": "\"Then let me be the cloud!\""
 },
 {
  "t0": 29.8,
  "t1": 33.69,
  "text": "He rained, and rained, and flooded the land."
 },
 {
  "t0": 35.8,
  "t1": 38.32,
  "text": "But one thing did not move."
 },
 {
  "t0": 38.4,
  "t1": 40.74,
  "text": "\"Let me be the mountain.\""
 },
 {
  "t0": 42.6,
  "t1": 45.84,
  "text": "Now he was mighty. Unmoving."
 },
 {
  "t0": 46.0,
  "t1": 49.14,
  "text": "Until he felt something at his feet."
 },
 {
  "t0": 50.6,
  "t1": 52.71,
  "text": "A stonecutter."
 },
 {
  "t0": 53.6,
  "t1": 57.06,
  "text": "\"Let me be myself,\" he whispered."
 },
 {
  "t0": 58.4,
  "t1": 62.43,
  "text": "Whatever you become, something will seem greater."
 },
 {
  "t0": 62.8,
  "t1": 67.5,
  "text": "Peace begins with who you are."
 }
]