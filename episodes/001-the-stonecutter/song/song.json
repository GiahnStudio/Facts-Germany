 "lines": [
  {
   "id": "L01",
   "t0": 0.3,
   "t1": 5.6,
   "text": "There once was a stonecutter who wished to be great"
  },
  {
   "id": "L02",
   "t0": 5.68,
   "t1": 10.52,
   "text": "A lord passed him by in his silk and his state"
  },
  {
   "id": "L03",
   "t0": 10.6,
   "t1": 15.18,
   "text": "Oh, if I were him, he sighed at the gate"
  },
  {
   "id": "L04",
   "t0": 15.22,
   "t1": 20.82,
   "text": "And so it was, by the turn of fate"
  },
  {
   "id": "L05",
   "t0": 20.96,
   "t1": 23.47,
   "text": "But the sun beat down on the lord all day"
  },
  {
   "id": "L06",
   "t0": 23.54,
   "t1": 26.21,
   "text": "Then let me be the sun, he heard himself say"
  },
  {
   "id": "L07",
   "t0": 26.29,
   "t1": 28.61,
   "text": "He burned as the sun and the earth turned dry"
  },
  {
   "id": "L08",
   "t0": 28.68,
   "t1": 31.23,
   "text": "Till a cloud rolled over and covered the sky"
  },
  {
   "id": "L09",
   "t0": 31.31,
   "t1": 36.25,
   "text": "Then let me be the cloud, was his cry"
  },
  {
   "id": "L10",
   "t0": 36.38,
   "t1": 39.19,
   "text": "He rained and he rained till the rivers ran wide"
  },
  {
   "id": "L11",
   "t0": 39.23,
   "t1": 41.93,
   "text": "But one thing stood still on the mountainside"
  },
  {
   "id": "L12",
   "t0": 42.02,
   "t1": 44.11,
   "text": "Let me be the mountain, he cried"
  },
  {
   "id": "L13",
   "t0": 44.22,
   "t1": 49.22,
   "text": "Now mighty, unmoving, he stood in his pride"
  },
  {
   "id": "L14",
   "t0": 49.29,
   "t1": 52.02,
   "text": "Then he felt a tap, tap, tap at his feet"
  },
  {
   "id": "L15",
   "t0": 52.07,
   "t1": 54.45,
   "text": "A stonecutter's chisel, steady and neat"
  },
  {
   "id": "L16",
   "t0": 54.51,
   "t1": 59.41,
   "text": "Let me be myself, he whispered, complete"
  },
  {
   "id": "L17",
   "t0": 59.69,
   "t1": 65.07,
   "text": "Whatever you become, something stands greater still"
  },
  {
   "id": "L18",
   "t0": 65.15,
   "t1": 70.46,
   "text": "Peace begins with who you are, and always will"
  }
 ]
}